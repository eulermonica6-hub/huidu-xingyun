# This file contains no secrets. Copy it to .env only when local development starts.
HUIDU_PROJECT_NAME=慧读星云
HUIDU_DATA_CONFIG=config/data_paths.json
HUIDU_MODEL_CONFIG=config/models.example.json

# The real file remains outside the code directory and must never be committed.
HUIDU_SECRET_FILE=../LLM api key.txt
HUIDU_ALLOW_UNLABELED_KEYS=false

# Model roles. Model IDs can be changed without changing the orchestration graph.
# 角色分级：路由/审校用快模型 qwen-flash，推理用 qwen-plus；zhipu 为 Provider 级兜底。
HUIDU_ROUTER_PROVIDER=ali
HUIDU_ROUTER_MODEL=qwen-flash
HUIDU_REASONER_PROVIDER=ali
HUIDU_REASONER_MODEL=qwen-plus
HUIDU_VERIFIER_PROVIDER=ali
HUIDU_VERIFIER_MODEL=qwen-flash
HUIDU_FALLBACK_PROVIDER=zhipu
HUIDU_FALLBACK_MODEL=glm-4-flash

# Provider variables are populated at runtime from the external secret file.
DEEPSEEK_API_KEY=
GROQ_API_KEY=
NVIDIA_API_KEY=
DASHSCOPE_API_KEY=

# Neo4j credentials must be supplied through the environment, never committed.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

HUIDU_LOG_LEVEL=INFO
HUIDU_ENABLE_LLM_TRACING=false

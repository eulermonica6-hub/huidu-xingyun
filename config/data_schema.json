        {"name": "self_loop_count", "type": "integer", "required": true, "description": "自环数"},
        {"name": "component_count", "type": "integer", "required": true, "description": "连通分量数"},
        {"name": "largest_component_nodes", "type": "integer", "required": true, "description": "最大连通分量节点数"},
        {"name": "largest_component_share", "type": "number", "required": true, "description": "最大连通分量占比"},
        {"name": "density", "type": "number", "required": true, "description": "无向图密度"},
        {"name": "mean_degree", "type": "number", "required": true, "description": "平均度"},
        {"name": "reciprocity", "type": "number", "required": true, "description": "互惠性"},
        {"name": "transitivity", "type": "number", "required": true, "description": "传递性"},
        {"name": "average_clustering", "type": "number", "required": true, "description": "平均聚类系数"},
        {"name": "degree_assortativity", "type": "number", "required": true, "description": "度同配性"},
        {"name": "community_count", "type": "integer", "required": true, "description": "社群数"},
        {"name": "modularity", "type": "number", "required": true, "description": "模块度"},
        {"name": "max_core_number", "type": "integer", "required": true, "description": "最大核数"},
        {"name": "estimated_diameter", "type": "integer", "required": true, "description": "估计直径"},
        {"name": "estimated_mean_shortest_path", "type": "number", "required": true, "description": "估计平均最短路径"}
      ]
    }
  }
}
